SQLITE_PATH=data/trajets.db
MONGO_URI=mongodb://localhost:27017
# Scraping ViaMichelin (python src/main.py run)
MONGO_DB=paramedic_michelin
MONGO_COLLECTION=trajets
# Base patron (dump data/dumps/transports) : paramedic.transports
PARAMEDIC_DB=paramedic
TRANSPORTS_COLLECTION=transports
SCRAPE_DELAY_SECONDS=3

# Navigateur : headless=true = pas de fenetre (defaut)
BROWSER_HEADLESS=true
BROWSER_CHANNEL=msedge
BROWSER_SLOW_MO_MS=0
SCRAPE_TIMEOUT_MS=120000
