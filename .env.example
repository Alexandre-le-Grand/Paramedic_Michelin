SQLITE_PATH=data/trajets.db
MONGO_URI=mongodb://localhost:27017
# Scraping ViaMichelin (python src/main.py run)
MONGO_DB=paramedic_michelin
MONGO_COLLECTION=trajets
# Base patron (dump data/dumps/transports) : paramedic.transports
PARAMEDIC_DB=paramedic
TRANSPORTS_COLLECTION=transports
# Source des trajets pour `python src/main.py run` (transports | csv)
TRAJETS_SOURCE=transports
SCRAPE_DELAY_SECONDS=0.5
# Parallele API : 1=sequentiel, 5 par defaut (baisser a 3 si erreurs 503)
SCRAPE_WORKERS=5
# Retry si ViaMichelin renvoie 503 (serveur sature)
SCRAPE_RETRY_MAX=5
SCRAPE_RETRY_BASE_SECONDS=2
# Max requetes HTTP ViaMichelin en meme temps (evite 503)
SCRAPE_API_CONCURRENCY=3
# Secours OSRM si vmrest ViaMichelin en 503 (defaut false ; ou --osrm)
SCRAPE_OSRM_FALLBACK=false
OSRM_BASE_URL=https://router.project-osrm.org
# Secours navigateur (lent, desactive par defaut)
SCRAPE_BROWSER_FALLBACK=false

# Navigateur : headless=true = pas de fenetre (defaut)
BROWSER_HEADLESS=true
BROWSER_CHANNEL=msedge
BROWSER_SLOW_MO_MS=0
SCRAPE_TIMEOUT_MS=120000
