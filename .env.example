# SQLite (fichier local) — base SQL demandee par le projet
SQLITE_PATH=data/trajets.db

# MongoDB — demarrer avec: docker compose up -d
MONGO_URI=mongodb://localhost:27017
MONGO_DB=paramedic_michelin
MONGO_COLLECTION=trajets

# Delai entre deux trajets (secondes)
SCRAPE_DELAY_SECONDS=3

# Navigateur: msedge recommande (anti-bot ViaMichelin)
BROWSER_CHANNEL=msedge
HEADLESS=true